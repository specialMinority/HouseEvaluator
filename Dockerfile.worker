FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 query && useradd --uid 10001 --gid query --no-create-home query \
    && useradd --uid 10002 --gid query --no-create-home gateway \
    && mkdir -p /state/worker /state/gateway /run/houseevaluator-egress \
    && chown 10001:10001 /state/worker \
    && chown 10002:10001 /state/gateway /run/houseevaluator-egress \
    && chmod 700 /state/worker /state/gateway && chmod 750 /run/houseevaluator-egress
COPY backend/__init__.py backend/__init__.py
COPY backend/v2/ backend/v2/

FROM base AS gateway
USER 10002:10001
CMD ["python", "-m", "backend.v2.egress_gateway"]

FROM base AS worker
USER 10001:10001
CMD ["python", "-m", "backend.v2.remote_worker"]
